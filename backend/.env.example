# Campus Cloud Dashboard — contoh konfigurasi backend.
# Salin ke .env di folder yang sama, isi nilai sesuai deployment Anda, JANGAN commit .env asli ke git.
# Lihat docs/PANDUAN_DEPLOYMENT.md untuk panduan lengkap.

# ── WAJIB ─────────────────────────────────────────────────────────────────────

# Tanda tangan JWT + basis kunci enkripsi (Fernet) untuk kredensial VM & token Proxmox
# yang disimpan di database. Generate sekali, jangan pernah diubah setelah ada data
# (mengubahnya akan membuat semua kredensial tersimpan tidak bisa didekripsi lagi).
#   openssl rand -hex 32
JWT_SECRET=

# Password admin Guacamole (user "guacadmin"). Backend otomatis merotasi password
# default guacadmin/guacadmin ke nilai ini saat pertama kali start. Pakai password kuat.
GUAC_ADMIN_PASS=

# Origin (domain/IP) tempat dashboard diakses, dipisah koma kalau lebih dari satu.
# Mis. http://10.0.0.5,https://dashboard.contoh.ac.id
ALLOWED_ORIGINS=http://localhost

# Password superadmin "admin" yang dibuat saat backend pertama kali start (database kosong).
# Kosong = admin123, yang wajib langsung diganti setelah login.
INITIAL_ADMIN_PASSWORD=

# Password database. Hanya berlaku saat volume database PERTAMA KALI dibuat; mengubahnya
# setelah itu tidak mengganti password yang sudah tersimpan di database.
# Kosong = bawaan lama (ccd123 / guacamole123), hanya untuk instalasi lama yang sudah jalan.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
GUAC_DB_PASSWORD=

# ── OPSIONAL ──────────────────────────────────────────────────────────────────

# Bastion SSH: mahasiswa SSH ke VM-nya dari terminal sendiri (ssh -J). Aktifkan dengan
# COMPOSE_PROFILES=ssh. Ini membuka port BASTION_PUBLIC_PORT ke internet.
COMPOSE_PROFILES=
# Token rahasia antara bastion dan backend. Diisi otomatis oleh setup.sh.
BASTION_TOKEN=
# Alamat dan port yang ditampilkan di perintah SSH. Kosong = alamat yang dipakai membuka dashboard.
# Alamatnya juga bisa diatur superadmin di tab Sistem, dan nilai di sana lebih diutamakan.
BASTION_PUBLIC_HOST=
BASTION_PUBLIC_PORT=2222

# Kunci enkripsi payload Redis. Kosongkan untuk nonaktifkan (mode kompatibel — data
# kredensial tetap terenkripsi lewat JWT_SECRET di atas, ini lapisan tambahan di Redis).
#   openssl rand -hex 32
AGENT_ENC_SECRET=

# Level log (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# Berapa lama audit log (login, create/delete VM, akses kredensial, dst) disimpan sebelum
# dibersihkan otomatis, hari. Berlaku juga untuk riwayat sesi Remote, Web, dan SSH. Sengaja lebih
# panjang dari retensi metrik VM/host — ini jejak keamanan/kepatuhan, sesuaikan dengan kebijakan
# retensi log institusi Anda.
AUDIT_RETENTION_DAYS=180

# Database Guacamole untuk riwayat sesi Remote. Kosong = sama dengan DATABASE_URL tetapi database
# guacamoledb (bawaan docker-compose.yml). Isi hanya kalau Guacamole memakai database lain.
# GUAC_DATABASE_URL=

# Interval polling metrik VM (via exporter node_exporter/windows_exporter), detik.
AGENT_POLL_INTERVAL=5

# Interval sampling disk IOPS per VM Proxmox, detik.
IOPS_POLL_INTERVAL=15

# Timeout menunggu banner SSH saat connect ke VM (untuk fitur otomasi SSH), detik.
SSH_BANNER_TIMEOUT=30

# Berapa lama koneksi SSH menganggur di connection pool sebelum ditutup, detik.
SSH_POOL_IDLE_TTL=60

# Jaringan VPS ini, format iface=cidr dipisah koma. Diisi otomatis oleh setup.sh (isi manual hanya
# kalau deploy tanpa setup.sh). Dipakai untuk menolak blok alamat switch yang bentrok dengan jaringan VPS.
HOST_NETWORKS=
